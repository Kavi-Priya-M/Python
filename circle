class circle(object):
  def __init__(self,r):
       self.radius = r
  def perimeter(self):
      return self.radius*2*22/7
  def area(self):
      return self.radius*self.radius*22/7
r =float(raw_input("enter the radius"))
a = circle(r)
print "the perimeter of circle",a.perimeter()
print "the area of circle",a.area()
