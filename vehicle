class Vehicle:
    def __init__(self, brand, model, year, color):
        self.brand = brand
        self.model = model
        self.year = year
        self.color = color

    def display(self):
        print"\nVehicle Details"
        print"Brand:", self.brand
        print"Model:", self.model
        print"Year:", self.year
        print"Color:", self.color
