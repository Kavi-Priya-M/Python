def remove_duplicates(input_tuple):
  unique_list = []
  for item in input_tuple:
    if item not in unique_list:
        unique_list.append(item)
  return tuple(unique_list)
original_tuple = (1, 2, 3, 2, 4, 1, 5, 3, 'a', 'b', 'a')
unique_tuple = remove_duplicates(original_tuple)
print "Original tuple:", original_tuple
print "Unique tuple (order preserved):", unique_tuple
